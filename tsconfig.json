{ 
  "compilerOptions": { 
    "target": "ES2020", 
    "module": "ESNext", 
    "outDir": "./dist", 
    "rootDir": "./src", 
    "strict": true, 
    "moduleResolution": "bundler", 
    "skipLibCheck": true, 
    "forceConsistentCasingInFileNames": true, 
    "declaration": true 
  }, 
  "include": ["src/**/*"], 
  "exclude": ["node_modules", "dist", "**/*.test.ts"] 
} 